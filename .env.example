# Copy to .env.local in the repository root. Do not commit real values.
# Phase 1: existing persistent PostgreSQL; db:check only performs SELECT 1.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
API_PORT=4000
API_HOST=127.0.0.1
API_ORIGIN=http://localhost:4000
PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Reserved for Phase 3; not used or required by the Phase 1 scaffold.
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
FACILITATOR_SEED_EMAIL=facilitator@example.test
FACILITATOR_SEED_PASSWORD=REPLACE_LOCALLY_NOT_IN_GIT
MANAGER_SEED_EMAIL=manager@example.test
MANAGER_SEED_PASSWORD=REPLACE_LOCALLY_NOT_IN_GIT
