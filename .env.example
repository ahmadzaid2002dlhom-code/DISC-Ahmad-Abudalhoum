# Copy to .env.local in the repository root. Do not commit real values.
# Existing persistent PostgreSQL. Apply the migration explicitly before starting.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
API_PORT=4000
API_HOST=127.0.0.1
API_ORIGIN=http://localhost:4000
PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Generate a random secret locally, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
FACILITATOR_SEED_EMAIL=facilitator@example.test
FACILITATOR_SEED_PASSWORD=REPLACE_LOCALLY_NOT_IN_GIT
MANAGER_SEED_EMAIL=manager@example.test
MANAGER_SEED_PASSWORD=REPLACE_LOCALLY_NOT_IN_GIT

# Production only: exact proxy IPs/CIDRs, never a blind hop count or 0.0.0.0/0.
# Verify the actual frontend -> Express chain and forwarded HTTPS headers first.
TRUSTED_PROXY_CIDRS=
PROXY_CONFIGURATION_VERIFIED=false

# Separate test instance: integration tests create/drop a random schema.
# test:e2e additionally requires CREATE DATABASE and drops only its fresh disc_e2e_* database.
TEST_DATABASE_URL=

# Backend build only, when the original private JSON is absent from a Git checkout.
# Supply unchanged original bytes as base64 in the hosting secret store. Fingerprint checked.
# Never configure this on the frontend or prefix it with NEXT_PUBLIC_.
PRIVATE_SEED_BASE64=
